# Copy this file to .env and fill in only the settings for the demos you run.
# Never commit .env or put real credentials in this template.

# Module 1 — Foundry OpenAI-compatible endpoint (used by most M1 demos)
AZURE_AI_FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=YOUR-API-KEY
AZURE_AI_FOUNDRY_MODEL=YOUR-MODEL-DEPLOYMENT

# Module 1 — optional Azure OpenAI endpoint for M1_15
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=YOUR-API-KEY
AZURE_OPENAI_MODEL=YOUR-MODEL-DEPLOYMENT

# Optional M1_10 comma-separated deployment names for model comparison
# M1_COMPARE_MODELS=deployment-a,deployment-b

# Module 2 — Foundry project endpoint; authenticate with `az login`
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Module 2 — optional M2_06 Foundry IQ MCP configuration
FOUNDRY_IQ_MCP_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net/knowledgebases/YOUR-KNOWLEDGE-BASE/mcp?api-version=2026-08-01-preview
FOUNDRY_IQ_CONNECTION_NAME=YOUR-REMOTE-TOOL-PROJECT-CONNECTION-ID

# Module 2 — optional existing portal-created prompt agent for M2_08
FOUNDRY_AGENT_NAME=YOUR-PROMPT-AGENT-NAME

# Module 3 — Azure AI Language
AZURE_LANGUAGE_ENDPOINT=https://YOUR-LANGUAGE-RESOURCE.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=YOUR-LANGUAGE-KEY

# Module 3 — Azure AI Speech
AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH-REGION.api.cognitive.microsoft.com/
AZURE_SPEECH_KEY=YOUR-SPEECH-KEY
AZURE_SPEECH_REGION=YOUR-SPEECH-REGION

# Module 3 — Azure AI Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_KEY=YOUR-TRANSLATOR-KEY
AZURE_TRANSLATOR_REGION=YOUR-TRANSLATOR-REGION

# Module 3 — optional saved Speech agent and Speech MCP storage
FOUNDRY_SPEECH_AGENT_NAME=YOUR-SPEECH-AGENT-NAME
AZURE_SPEECH_MCP_STORAGE_SAS_URL=YOUR-CONTAINER-SAS-URL

# Module 3 extension — GlobalCare enterprise demo (optional)
GC_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
GC_FOUNDRY_MODEL_DEPLOYMENT=YOUR-DEPLOYMENT
GC_FOUNDRY_MODEL_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
GC_FOUNDRY_MODEL_KEY=YOUR-API-KEY
GC_FOUNDRY_VOICE_AGENT_NAME=YOUR-SAVED-VOICE-AGENT
GC_LANGUAGE_ENDPOINT=https://YOUR-LANGUAGE.cognitiveservices.azure.com/
GC_LANGUAGE_KEY=YOUR-LANGUAGE-KEY
GC_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
GC_TRANSLATOR_KEY=YOUR-TRANSLATOR-KEY
GC_TRANSLATOR_REGION=YOUR-RESOURCE-REGION
