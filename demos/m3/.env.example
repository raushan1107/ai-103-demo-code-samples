# M3_07 Speech translation
AZURE_SPEECH_KEY=YOUR-SPEECH-KEY
AZURE_SPEECH_REGION=YOUR-SPEECH-REGION

# M3_08 GlobalCare. Copy needed placeholders to repository-root .env.
GC_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
GC_FOUNDRY_MODEL_DEPLOYMENT=YOUR-DEPLOYMENT
# M1-compatible Responses path only; hosted agent/Voice Live use Entra ID.
GC_FOUNDRY_MODEL_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
GC_FOUNDRY_MODEL_KEY=YOUR-API-KEY
GC_FOUNDRY_VOICE_AGENT_NAME=YOUR-SAVED-VOICE-AGENT
GC_LANGUAGE_ENDPOINT=https://YOUR-LANGUAGE.cognitiveservices.azure.com/
GC_LANGUAGE_KEY=YOUR-LANGUAGE-KEY
GC_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
GC_TRANSLATOR_KEY=YOUR-TRANSLATOR-KEY
GC_TRANSLATOR_REGION=YOUR-RESOURCE-REGION
